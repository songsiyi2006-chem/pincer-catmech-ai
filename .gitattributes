* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.pdf binary
*.png binary
*.zip binary
*.npz binary
# Scientific source hashes cover original bytes, including native line endings.
# Do not normalize archived geometries, spectra, command records or datasets.
data/** -text whitespace=-blank-at-eol,-blank-at-eof
# Preserve generated bytes that are bound to final Phase 3 artifact receipts.
docs/PHASE3_PDF_BUILD_AUDIT.json -text whitespace=cr-at-eol
examples/plots/phase3_*.svg -text whitespace=cr-at-eol
# This additive research package has a byte-level manifest, including native output.
projects/cu-np-operando/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
